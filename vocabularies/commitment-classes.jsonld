      "termCode": "capital",
      "name": "Capital",
      "description": "A scarce resource committed through Participation that is transferred, reserved, consumed or otherwise made available in support of an Ecosystem.",
      "inDefinedTermSet": "https://raw.githubusercontent.com/fe-lixe/meaningful-participation/main/vocabularies/commitment-classes.jsonld"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://raw.githubusercontent.com/fe-lixe/meaningful-participation/main/vocabularies/commitment-classes.jsonld#effort",
      "termCode": "effort",
      "name": "Effort",
      "description": "The application of human capacity through Participation.",
      "inDefinedTermSet": "https://raw.githubusercontent.com/fe-lixe/meaningful-participation/main/vocabularies/commitment-classes.jsonld"
    },
    {
