    },
    {
      "@type": "DefinedTerm",
      "@id": "https://raw.githubusercontent.com/fe-lixe/meaningful-participation/main/vocabularies/commitment-classes.jsonld#standing",
      "termCode": "standing",
      "name": "Standing",
      "description": "The commitment of a Participant's recognised position, authority, accountability or reputation through Participation.",
      "inDefinedTermSet": "https://raw.githubusercontent.com/fe-lixe/meaningful-participation/main/vocabularies/commitment-classes.jsonld"
