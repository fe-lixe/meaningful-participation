{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fe-lixe.github.io/meaningful-participation/1.0/schemas/participation-credential.schema.json",
  "title": "MPP Participation Credential",
  "description": "A Participation Record expressed as a W3C Verifiable Credential 2.0 for one subject Participant, in accordance with SPECIFICATION.md section 29. Unknown properties are permitted, as in the VC 2.0 data model.",
  "type": "object",
  "required": [
    "@context",
    "type",
    "issuer",
    "validFrom",
    "credentialSubject"
  ],
  "properties": {
    "@context": {
      "type": "array",
      "minItems": 2,
      "allOf": [
        {
          "prefixItems": [
            {
              "const": "https://www.w3.org/ns/credentials/v2"
            }
          ],
          "minItems": 1,
          "items": true
        }
      ],
      "contains": {
        "type": "string",
        "pattern": "^https://fe-lixe\\.github\\.io/meaningful-participation/1\\.[0-9]+/context/mpp\\.jsonld$"
      },
      "description": "The VC 2.0 context first, followed by an MPP 1.x context."
    },
    "id": {
      "type": "string",
      "format": "uri",
      "description": "The credential identifier. It differs from the identifier of the embedded Participation Record."
    },
    "type": {
      "type": "array",
      "allOf": [
        {
          "contains": {
            "const": "VerifiableCredential"
          }
        },
        {
          "contains": {
            "const": "ParticipationCredential"
          }
        }
      ]
    },
    "issuer": {
      "description": "The asserter of the embedded Participation Record.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "validFrom": {
      "type": "string",
      "format": "date-time",
      "description": "Equal to the recordCreationTimestamp of the embedded Participation Record."
    },
    "credentialSubject": {
      "type": "object",
      "description": "Exactly one subject Participant and the Participation Record that recognises their Participation.",
      "required": [
        "id",
        "participationRecord"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "The identifier of a Participant assigned the subject Role in the embedded Participation Record."
        },
        "participationRecord": {
          "$ref": "https://fe-lixe.github.io/meaningful-participation/1.0/schemas/participation-record.schema.json",
          "not": {
            "type": "object",
            "properties": {
              "integrity": true
            },
            "required": [
              "integrity"
            ]
          },
          "description": "The Participation Record, embedded without its integrity property, which the credential's proof replaces."
        }
      }
    },
    "credentialStatus": {
      "description": "Status entries, for example a BitstringStatusListEntry for revocation or suspension.",
      "anyOf": [
        {
          "$ref": "#/$defs/statusEntry"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/statusEntry"
          }
        }
      ]
    },
    "proof": {
      "description": "One or more securing proofs, for example a Data Integrity proof using eddsa-rdfc-2022.",
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      ]
    }
  },
  "$defs": {
    "statusEntry": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "statusPurpose": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
